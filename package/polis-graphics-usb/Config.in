config BR2_PACKAGE_POLIS_GRAPHICS_USB
	bool "Polis screen graphics USB workers"
	depends on BR2_aarch64
	depends on BR2_TOOLCHAIN_USES_MUSL
	depends on BR2_INIT_BUSYBOX
	depends on BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV
	help
	  Install the prepared hdmi-graphics-hello executable and a libc-only
	  mdev event receiver supervising one worker per matching Pico.
	  Prepare the app with package/polis-graphics-usb/prepare.py first.
