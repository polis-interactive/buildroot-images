# Host access for supported Polis devices, independent of username, serial or port.
# Membership in polis-wired permits direct access to matching devices.
# The daemon separately checks the commissioned fixture identities before use.
ACTION!="add|change", GOTO="polis_wired_end"

# Pi 4 ROM loader used by rpiboot/libusb.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0a5c", ATTR{idProduct}=="2711", OWNER:="root", GROUP:="polis-wired", MODE:="0660"

# Pico firmware's control/UART channel, and the Pi image's diagnostic channel.
SUBSYSTEM=="tty", KERNEL=="ttyACM[0-9]*", ATTRS{idVendor}=="c0de", ATTRS{idProduct}=="cafe", ATTRS{product}=="Polis Wired Control", OWNER:="root", GROUP:="polis-wired", MODE:="0660"
SUBSYSTEM=="tty", KERNEL=="ttyACM[0-9]*", ATTRS{product}=="Polis_Pi_Diagnostics", OWNER:="root", GROUP:="polis-wired", MODE:="0660"

# Official Pi RAM gadget's microSD LUN only. IDs are supplied by the earlier
# persistent-storage rules and inherited by partitions. Other USB disks and
# other LUNs receive neither permissions nor the automount exclusion.
SUBSYSTEM=="block", ENV{DEVTYPE}=="disk|partition", ENV{ID_BUS}=="usb", ENV{ID_VENDOR_ID}=="0a5c", ENV{ID_MODEL_ID}=="0104", ENV{ID_VENDOR}=="mmcblk0", ENV{ID_TYPE}=="disk", ENV{ID_INSTANCE}=="0:0", ENV{UDISKS_IGNORE}="1"
SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", ENV{ID_BUS}=="usb", ENV{ID_VENDOR_ID}=="0a5c", ENV{ID_MODEL_ID}=="0104", ENV{ID_VENDOR}=="mmcblk0", ENV{ID_TYPE}=="disk", ENV{ID_INSTANCE}=="0:0", OWNER:="root", GROUP:="polis-wired", MODE:="0660"

LABEL="polis_wired_end"
