#!/bin/sh
# Called directly by BusyBox init after mount -a, before storage and rcS.
DAEMON=/usr/bin/polis-gpio-test
PIDFILE=/run/polis-gpio-test.pid
LOGFILE=/run/polis-gpio-test.log

case "$1" in
    start)
        start-stop-daemon -S -q -b -m -O "$LOGFILE" -p "$PIDFILE" -x "$DAEMON" \
            -- 26 /dev/ttyAMA0 19 >>"$LOGFILE" 2>&1
        ;;
    stop)
        start-stop-daemon -K -q -p "$PIDFILE" -x "$DAEMON"
        ;;
    *)
        echo "Usage: $0 {start|stop}" >&2
        exit 1
        ;;
esac
