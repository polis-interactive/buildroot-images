#!/bin/sh
# Called directly by BusyBox init after mount -a, before storage and rcS.
DAEMON=/usr/bin/polis-boot-diagnostics
PIDFILE=/run/polis-boot-diagnostics.pid
LOGFILE=/run/polis-boot-diagnostics.log

case "$1" in
    start)
        start-stop-daemon -S -q -b -m -O "$LOGFILE" -p "$PIDFILE" -x "$DAEMON" >>"$LOGFILE" 2>&1
        ;;
    stop)
        start-stop-daemon -K -q -o -p "$PIDFILE" -x "$DAEMON"
        ;;
    *)
        echo "Usage: $0 {start|stop}" >&2
        exit 1
        ;;
esac
