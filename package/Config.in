source "$BR2_EXTERNAL_POLIS_PATH/package/polis-gpio-test/Config.in"
source "$BR2_EXTERNAL_POLIS_PATH/package/polis-firmware-tools/Config.in"

config BR2_POLIS_PREFER_STATIC
	bool "Prefer static executables in the Polis image"
	depends on BR2_TOOLCHAIN_USES_MUSL
	depends on BR2_SHARED_STATIC_LIBS
	help
	  Link the core boot executables statically while retaining
	  shared-library support for packages such as BlueZ. Requires
	  the Polis musl board's patches and BusyBox config fragment.
