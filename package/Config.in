source "$BR2_EXTERNAL_POLIS_PATH/package/polis-boot-diagnostics/Config.in"
source "$BR2_EXTERNAL_POLIS_PATH/package/polis-firstboot/Config.in"
source "$BR2_EXTERNAL_POLIS_PATH/package/polis-wifi-setupd/Config.in"
source "$BR2_EXTERNAL_POLIS_PATH/package/polis-dtmerge/Config.in.host"
source "$BR2_EXTERNAL_POLIS_PATH/package/polis-dtoverlay/Config.in"

config BR2_POLIS_RPI4_VL805_FIRMWARE
	bool "Use Pi 4 boot firmware with the VL805 decompressor fix"
	depends on BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI4
	help
	  Replace start4.elf and fixup4.dat with the pinned upstream fix for
	  VL805 initialization when the bootloader has not initialized USB.
	  Keep the existing kernel, DTBs and overlays. No EEPROM update.

config BR2_POLIS_KERNEL_LOGO
	bool "Embed the preconverted Polis kernel logo"
	depends on BR2_LINUX_KERNEL
	help
	  Copy the supplied 512x512 CLUT224 PPM into the kernel before
	  compilation. No host image converter is needed during builds.

config BR2_POLIS_KERNEL_ENTRY
	bool "Emit the Polis Linux entry benchmark marker"
	depends on BR2_aarch64
	depends on BR2_LINUX_KERNEL
	help
	  Instrument Linux entry for the Pico UART benchmark. Profile builds
	  select this explicitly through the kernel-entry-marker group.

config BR2_POLIS_PREFER_STATIC
	bool "Prefer static executables in the Polis image"
	depends on BR2_TOOLCHAIN_USES_MUSL
	depends on BR2_SHARED_STATIC_LIBS
	help
	  Link the core boot executables statically while retaining
	  shared-library support for packages such as BlueZ. Requires
	  the Polis musl board's patches and BusyBox config fragment.

config BR2_POLIS_SPLASH_SCREEN
	bool "Polis persistent Rust DRM splash"
	depends on BR2_LINUX_KERNEL && BR2_aarch64
	help
	  Build the private Rust DRM client into VC4 for screen development.
	  Needs host rustc, matching rust-src, bindgen and libclang; adds no
	  userspace runtime dependencies. The profile disables fbdev/fbcon.
