#!/bin/sh
# Opt-in QEMU probe. Normal Pi boots never open or write to the application UART.
[ "$1" = start ] || exit 0
case " $(cat /proc/cmdline) " in
    *" polis.smoke=1 "*) ;;
    *) exit 0 ;;
esac
case " $(cat /proc/cmdline) " in
    *" polis.smoke.checks=1 "*) ;;
    *) exit 0 ;;
esac

exec >/dev/ttyAMA0 2>&1
set -eu

fail() {
    echo "POLIS_SMOKE_FAIL $*"
    cat /proc/mounts
    dmesg
    exit 1
}

milestone() {
    read -r uptime idle </proc/uptime
    echo "POLIS_SMOKE_READY $1 uptime=$uptime"
}

mounted() {
    awk -v path="$1" -v type="$2" -v mode="$3" '
        $2 == path && (type == "any" || $3 == type) {
            n = split($4, options, ",")
            for (i = 1; i <= n; i++) if (options[i] == mode) found = 1
        }
        END { exit !found }
    ' /proc/mounts
}

echo POLIS_SMOKE_START
if [ -x /etc/init.d/mount-data ]; then
    mounted / any ro || fail "root is not read-only"
    mounted /run tmpfs rw || fail "/run is not writable tmpfs"
    mounted /tmp tmpfs rw || fail "/tmp is not writable tmpfs"
    mounted /data ext4 rw || fail "/data is not writable ext4"
    mounted /var/lib ext4 rw || fail "/var/lib is not persistent ext4"
    probe="/data/config/.polis-smoke-$$"
    echo polis-smoke >"$probe" || fail "cannot write /data/config"
    [ "$(cat "$probe")" = polis-smoke ] || fail "cannot read /data/config"
    rm "$probe"
    probe="/var/lib/.polis-smoke-$$"
    echo polis-smoke >"$probe" || fail "cannot write /var/lib"
    [ "$(cat "/data/var-lib/.polis-smoke-$$")" = polis-smoke ] || fail "missing /var/lib bind mount"
    rm "$probe"
else
    # Original glibc profile uses a writable root, with no /data partition.
    mounted / ext4 rw || fail "legacy root is not writable ext4"
fi
milestone storage

# rcS returning does not establish daemon readiness. Exercise both services.
tries=0
until dbus-send --system --print-reply --reply-timeout=1000 \
    --dest=net.connman.iwd / org.freedesktop.DBus.ObjectManager.GetManagedObjects \
    >/run/polis-smoke-dbus.log 2>&1; do
    tries=$((tries + 1))
    if [ "$tries" -ge 50 ]; then
        cat /run/polis-smoke-dbus.log
        fail "D-Bus/iwd did not respond"
    fi
    sleep 0.1
done
milestone services
