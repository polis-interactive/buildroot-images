#!/bin/sh
# Run once from inittab, before rcS. Never format a missing/damaged data volume.
set -eu

# initramfs can reach userspace before the SD controller finishes probing.
tries=0
while [ ! -b /dev/mmcblk0p3 ]; do
    tries=$((tries + 1))
    if [ "$tries" -ge 100 ]; then
        echo "Persistent data partition /dev/mmcblk0p3 is unavailable" >&2
        exit 1
    fi
    sleep 0.1
done

mount /data
mkdir -p /data/config
# Seed package-provided state once, preserving ownership and permissions.
# Rename only after the copy finishes so a power loss retries the initialization.
if [ ! -d /data/var-lib ]; then
    mkdir -p /data/var-lib.new
    cp -a /var/lib/. /data/var-lib.new/
    mv /data/var-lib.new /data/var-lib
fi
mount /var/lib
# 'ro' on the command line does not make an unpacked initramfs read-only.
# Check/enforce it before rcS services; the stateless GPIO test starts earlier.
mount -o remount,ro /
