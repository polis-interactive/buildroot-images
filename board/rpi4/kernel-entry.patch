From: Polis bench <bench@polis.local>
Subject: [PATCH] arm64: mark Pi 4 primary entry on its existing PL011 UART

Pi 4 bench images only. Bounded MMIO output; boot arguments preserved.
No printk timestamp is used as a power-on measurement.

--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -82,6 +82,48 @@
 	 *  x21        primary_entry() .. start_kernel()        FDT pointer passed at boot in x0
 	 */
 SYM_CODE_START(primary_entry)
+	/* Polis Pi 4B bench: emit directly before any printk buffering.
+	 * Only x9-x13 are scratch; preserve boot arguments x0-x3 and LR.
+	 * Skip physical MMIO if entered with MMU on. This image is Pi 4 only.
+	 * Firmware enable_uart=1 must have enabled PL011 TX at 115200.
+	 * Every poll shares a finite budget; a broken UART cannot hang boot.
+	 */
+	mrs	x9, CurrentEL
+	cmp	x9, #CurrentEL_EL2
+	b.eq	.Lpolis_el2
+	mrs	x9, sctlr_el1
+	b	.Lpolis_mmu
+.Lpolis_el2:
+	mrs	x9, sctlr_el2
+.Lpolis_mmu:
+	tbnz	x9, #0, .Lpolis_done
+	mov	x9, #0xfe200000
+	add	x9, x9, #0x1000
+	ldr	w10, [x9, #0x30] // UARTCR: UARTEN and TXE
+	tbz	w10, #0, .Lpolis_done
+	tbz	w10, #8, .Lpolis_done
+	mov	w13, #0x100000
+.Lpolis_idle:
+	subs	w13, w13, #1
+	b.eq	.Lpolis_done
+	ldr	w10, [x9, #0x18] // UARTFR BUSY: drain earlier firmware text
+	tbnz	w10, #3, .Lpolis_idle
+	adr	x11, .Lpolis_marker
+.Lpolis_next:
+	ldrb	w12, [x11], #1
+	cbz	w12, .Lpolis_done
+.Lpolis_wait:
+	subs	w13, w13, #1
+	b.eq	.Lpolis_done
+	ldr	w10, [x9, #0x18]
+	tbnz	w10, #5, .Lpolis_wait // TXFF
+	str	w12, [x9]
+	dsb	sy
+	b	.Lpolis_next
+.Lpolis_marker:
+	.asciz "\nPLIS_ENTRY_V1\n"
+	.balign 4
+.Lpolis_done:
 	bl	record_mmu_state
 	bl	preserve_boot_args
 
